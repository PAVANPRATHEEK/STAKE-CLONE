# MongoDB Atlas connection string (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/stake_clone?retryWrites=true&w=majority

# Optional: Custom SMTP credentials (defaults to Ethereal test mailer if omitted)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password
